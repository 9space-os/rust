diff --git a/clang/include/clang/Sema/SemaPlan9.h b/clang/include/clang/Sema/SemaPlan9.h
new file mode 100644
index 0000000000000000000000000000000000000000..02cb29b0e2166898444d4e5d59cde1580e5d48b3
--- /dev/null
+++ b/clang/include/clang/Sema/SemaPlan9.h
@@ -0,0 +1,98 @@
+//===----- SemaPlan9.h ---- Plan 9 C: #pragma varargck --------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+///
+/// \file
+/// Plan 9's print format checking as kencc does it (9front's
+/// sys/src/cmd/cc/dpchk.c): "#pragma varargck argpos NAME N" names a function
+/// whose N-th argument is a format, "type FMT TYPE" says which argument type
+/// a conversion takes (void: none), "flag 'c'" makes c a flag. Each call of
+/// such a function with a string literal for its format has its arguments
+/// checked against the conversions.
+///
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_SEMA_SEMAPLAN9_H
+#define LLVM_CLANG_SEMA_SEMAPLAN9_H
+
+#include "clang/AST/Type.h"
+#include "clang/Basic/SourceLocation.h"
+#include "clang/Sema/SemaBase.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/StringRef.h"
+#include <string>
+#include <vector>
+
+namespace clang {
+class CallExpr;
+class Expr;
+class FunctionDecl;
+class IdentifierInfo;
+
+class SemaPlan9 : public SemaBase {
+public:
+  SemaPlan9(Sema &S);
+
+  /// #pragma varargck argpos NAME POS
+  void ActOnPragmaVarargckArgpos(const IdentifierInfo *Name, unsigned Pos,
+                                 SourceLocation Loc);
+  /// #pragma varargck type "FMT" TYPE [*...]; the type name is looked up
+  /// at file scope when a call is checked.
+  void ActOnPragmaVarargckType(llvm::StringRef Fmt, const IdentifierInfo *Type,
+                               unsigned Stars, SourceLocation Loc);
+  /// #pragma varargck flag 'C'
+  void ActOnPragmaVarargckFlag(uint32_t C);
+
+  /// Checks a call of a function named by an argpos pragma.
+  void checkVarargckCall(const FunctionDecl *FD, const CallExpr *Call);
+
+private:
+  /// What a character of a conversion is (kencc's Fignor, Fstar, Fl, Fvl).
+  enum CharKind : uint8_t { CK_Verb, CK_Ignore, CK_Star, CK_L, CK_VL };
+
+  /// A conversion's signature: its l and ll (or z) flags and its verb
+  /// (0: none; x and X are o's).
+  struct Signature {
+    bool L = false, VL = false;
+    uint32_t Verb = 0;
+    bool operator==(const Signature &O) const {
+      return L == O.L && VL == O.VL && Verb == O.Verb;
+    }
+  };
+
+  struct Proto {
+    Signature Sig;
+    const IdentifierInfo *TypeName;
+    unsigned Stars;
+    SourceLocation Loc;
+    /// the type, once its name is one
+    mutable QualType Type;
+  };
+
+  void init();
+  CharKind kindOf(uint32_t C) const;
+  /// The signature of the conversion at S[I] (the text after a '%'): its
+  /// text in Spec, the '*' it holds in NStar.
+  Signature getFlag(llvm::StringRef S, size_t I, unsigned &NStar,
+                    std::string &Spec) const;
+  /// A proto's type, null while its name is not (yet) a type.
+  QualType resolve(const Proto &P) const;
+  /// kencc's sametype for an argument: void * matches any pointer at the
+  /// top level, qualifiers do not count.
+  bool sameType(QualType A, QualType B, bool Top) const;
+  /// The type an argument is checked by (an enum's: see there).
+  QualType argType(const Expr *E) const;
+
+  bool Inited = false;
+  llvm::DenseMap<uint32_t, CharKind> Kinds;
+  llvm::DenseMap<const IdentifierInfo *, unsigned> ArgPos;
+  std::vector<Proto> Protos;
+};
+
+} // namespace clang
+
+#endif // LLVM_CLANG_SEMA_SEMAPLAN9_H
