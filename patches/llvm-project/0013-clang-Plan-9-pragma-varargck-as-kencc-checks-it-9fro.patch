diff --git a/clang/lib/Sema/SemaPlan9.cpp b/clang/lib/Sema/SemaPlan9.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..5afe9f8e5080814f7e6ff06318558841832d3087
--- /dev/null
+++ b/clang/lib/Sema/SemaPlan9.cpp
@@ -0,0 +1,290 @@
+//===------ SemaPlan9.cpp ---- Plan 9 C: #pragma varargck -----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// kencc's format checking (9front's sys/src/cmd/cc/dpchk.c), written from
+// what it does: the same conversions, the same matching of argument types,
+// the same warnings.
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/Sema/SemaPlan9.h"
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/Expr.h"
+#include "clang/Basic/DiagnosticSema.h"
+#include "clang/Basic/TargetInfo.h"
+#include "clang/Sema/Lookup.h"
+#include "clang/Sema/Sema.h"
+#include "llvm/ADT/StringSwitch.h"
+#include "llvm/Support/ConvertUTF.h"
+
+using namespace clang;
+
+SemaPlan9::SemaPlan9(Sema &S) : SemaBase(S) {}
+
+// kencc's arginit: digits . # u h + - are flags without meaning for the
+// type, * takes an int, l is long, ll and z (where a pointer is as wide as a
+// vlong) are vlong; x and X are o.
+void SemaPlan9::init() {
+  if (Inited)
+    return;
+  Inited = true;
+  for (uint32_t C = '0'; C <= '9'; ++C)
+    Kinds[C] = CK_Ignore;
+  for (uint32_t C : {'.', '#', 'u', 'h', '+', '-'})
+    Kinds[C] = CK_Ignore;
+  Kinds['*'] = CK_Star;
+  Kinds['l'] = CK_L;
+  const TargetInfo &TI = getASTContext().getTargetInfo();
+  Kinds['z'] =
+      TI.getLongLongWidth() == TI.getPointerWidth(LangAS::Default) ? CK_VL
+                                                                   : CK_L;
+}
+
+SemaPlan9::CharKind SemaPlan9::kindOf(uint32_t C) const {
+  auto It = Kinds.find(C);
+  return It == Kinds.end() ? CK_Verb : It->second;
+}
+
+// One character of S at I, decoded from UTF-8 (a byte that is not UTF-8
+// stands for itself); 0 at the end.
+static uint32_t nextChar(llvm::StringRef S, size_t &I) {
+  if (I >= S.size())
+    return 0;
+  const llvm::UTF8 *P = reinterpret_cast<const llvm::UTF8 *>(S.data() + I);
+  const llvm::UTF8 *E = reinterpret_cast<const llvm::UTF8 *>(S.data() + S.size());
+  llvm::UTF32 C;
+  const llvm::UTF8 *Start = P;
+  if (llvm::convertUTF8Sequence(&P, E, &C, llvm::strictConversion) !=
+      llvm::conversionOK) {
+    C = static_cast<unsigned char>(S[I]);
+    P = Start + 1;
+  }
+  I += P - Start;
+  return C;
+}
+
+// kencc's getflag: the flags up to the verb, the first character that is no
+// flag; a character from 512 up ends the conversion without one.
+SemaPlan9::Signature SemaPlan9::getFlag(llvm::StringRef S, size_t I,
+                                        unsigned &NStar,
+                                        std::string &Spec) const {
+  Signature Sig;
+  NStar = 0;
+  Spec.clear();
+  while (Spec.size() < 99) {
+    size_t Start = I;
+    uint32_t C = nextChar(S, I);
+    if (C == 0 || C >= 512)
+      break;
+    Spec.append(S.data() + Start, I - Start);
+    switch (kindOf(C)) {
+    case CK_Star:
+      ++NStar;
+      continue;
+    case CK_Ignore:
+      continue;
+    case CK_L:
+      if (Sig.L)
+        Sig.VL = true;
+      Sig.L = true;
+      continue;
+    case CK_VL:
+      Sig.VL = true;
+      continue;
+    case CK_Verb:
+      Sig.Verb = (C == 'x' || C == 'X') ? 'o' : C;
+      return Sig;
+    }
+  }
+  return Sig;
+}
+
+void SemaPlan9::ActOnPragmaVarargckArgpos(const IdentifierInfo *Name,
+                                          unsigned Pos, SourceLocation Loc) {
+  auto [It, New] = ArgPos.try_emplace(Name, Pos);
+  if (!New && It->second != Pos)
+    Diag(Loc, diag::warn_plan9_varargck_redefined) << Name << It->second;
+}
+
+void SemaPlan9::ActOnPragmaVarargckType(llvm::StringRef Fmt,
+                                        const IdentifierInfo *Type,
+                                        unsigned Stars, SourceLocation Loc) {
+  init();
+  unsigned NStar;
+  std::string Spec;
+  Signature Sig = getFlag(Fmt, 0, NStar, Spec);
+  for (const Proto &P : Protos)
+    if (P.Sig == Sig && P.TypeName == Type && P.Stars == Stars)
+      return;
+  Protos.push_back({Sig, Type, Stars, Loc, QualType()});
+}
+
+void SemaPlan9::ActOnPragmaVarargckFlag(uint32_t C) {
+  init();
+  if (C < 512)
+    Kinds[C] = CK_Ignore;
+}
+
+QualType SemaPlan9::resolve(const Proto &P) const {
+  if (!P.Type.isNull())
+    return P.Type;
+  ASTContext &Ctx = getASTContext();
+  QualType T = llvm::StringSwitch<QualType>(P.TypeName->getName())
+                   .Case("void", Ctx.VoidTy)
+                   .Case("char", Ctx.CharTy)
+                   .Case("short", Ctx.ShortTy)
+                   .Case("int", Ctx.IntTy)
+                   .Case("signed", Ctx.IntTy)
+                   .Case("unsigned", Ctx.UnsignedIntTy)
+                   .Case("long", Ctx.LongTy)
+                   .Case("float", Ctx.FloatTy)
+                   .Case("double", Ctx.DoubleTy)
+                   .Case("_Bool", Ctx.BoolTy)
+                   .Default(QualType());
+  if (T.isNull()) {
+    Sema &S = SemaRef;
+    if (!S.TUScope)
+      return QualType();
+    NamedDecl *D =
+        S.LookupSingleName(S.TUScope, DeclarationName(
+                                          const_cast<IdentifierInfo *>(P.TypeName)),
+                           P.Loc, Sema::LookupOrdinaryName);
+    auto *TD = dyn_cast_or_null<TypedefNameDecl>(D);
+    if (!TD)
+      return QualType();
+    T = TD->getUnderlyingType();
+  }
+  for (unsigned I = 0; I < P.Stars; ++I)
+    T = Ctx.getPointerType(T);
+  P.Type = T;
+  return T;
+}
+
+bool SemaPlan9::sameType(QualType A, QualType B, bool Top) const {
+  ASTContext &Ctx = getASTContext();
+  A = Ctx.getCanonicalType(A).getUnqualifiedType();
+  B = Ctx.getCanonicalType(B).getUnqualifiedType();
+  if (A == B)
+    return true;
+  const auto *PA = A->getAs<PointerType>();
+  const auto *PB = B->getAs<PointerType>();
+  if (!PA || !PB)
+    return false;
+  QualType EA = PA->getPointeeType(), EB = PB->getPointeeType();
+  if (Top && (EA->isVoidType() || EB->isVoidType()))
+    return true;
+  return sameType(EA, EB, false);
+}
+
+// The type an argument is checked by. kencc's enums are int; here an enum
+// is int when its integer type is no wider (gcc's choice of unsigned int for
+// an enum without negative values is no mismatch), its integer type else.
+QualType SemaPlan9::argType(const Expr *E) const {
+  QualType T = E->getType();
+  // a variadic argument's promotion has cast an enum to its integer type
+  if (const auto *ET = E->IgnoreParenImpCasts()->getType()->getAs<EnumType>())
+    if (const EnumDecl *ED = ET->getDecl()->getDefinition()) {
+      ASTContext &Ctx = getASTContext();
+      T = ED->getIntegerType();
+      if (!T.isNull() && Ctx.getTypeSize(T) <= Ctx.getTypeSize(Ctx.IntTy))
+        T = Ctx.IntTy;
+    }
+  return T;
+}
+
+// kencc's checkargs: each '%' of the format takes the arguments its '*'
+// and its verb want, in order; a verb whose type is void takes none.
+void SemaPlan9::checkVarargckCall(const FunctionDecl *FD,
+                                  const CallExpr *Call) {
+  if (ArgPos.empty())
+    return;
+  const IdentifierInfo *II = FD->getIdentifier();
+  if (!II)
+    return;
+  auto It = ArgPos.find(II);
+  if (It == ArgPos.end())
+    return;
+  init();
+  unsigned Pos = It->second, N = Call->getNumArgs();
+  if (Pos == 0 || Pos > N) {
+    Diag(Call->getBeginLoc(), diag::warn_plan9_format_no_arg);
+    return;
+  }
+  const auto *SL =
+      dyn_cast<StringLiteral>(Call->getArg(Pos - 1)->IgnoreParenImpCasts());
+  if (!SL || !SL->isOrdinary())
+    return;
+  llvm::StringRef S = SL->getString();
+  ASTContext &Ctx = getASTContext();
+
+  unsigned A = Pos; // the next argument (0-based); its number is A+1
+  size_t I = 0;
+  for (;;) {
+    size_t Pc = S.find('%', I);
+    if (Pc == llvm::StringRef::npos) {
+      if (A < N)
+        Diag(Call->getArg(A)->getBeginLoc(), diag::warn_plan9_format_extra_args)
+            << Call->getArg(A)->getType();
+      return;
+    }
+    I = Pc + 1;
+    unsigned NStar;
+    std::string Spec;
+    Signature Sig = getFlag(S, I, NStar, Spec);
+    for (; NStar > 0; --NStar) {
+      if (A >= N) {
+        Diag(Call->getRParenLoc(), diag::warn_plan9_format_missing_args)
+            << Spec;
+        return;
+      }
+      const Expr *E = Call->getArg(A++);
+      if (E->containsErrors())
+        continue;
+      QualType T = argType(E);
+      if (!sameType(T, Ctx.IntTy, true) && !sameType(T, Ctx.UnsignedIntTy, true))
+        Diag(E->getBeginLoc(), diag::warn_plan9_format_star_mismatch)
+            << Spec << E->getType() << A;
+    }
+    bool Void = false;
+    for (const Proto &P : Protos)
+      if (P.Sig == Sig && P.Stars == 0) {
+        QualType T = resolve(P);
+        if (!T.isNull() && T->isVoidType()) {
+          Void = true;
+          break;
+        }
+      }
+    if (Void) {
+      // kencc steps over the character after the '%' only
+      ++I;
+      continue;
+    }
+    if (A >= N) {
+      Diag(Call->getRParenLoc(), diag::warn_plan9_format_missing_args) << Spec;
+      return;
+    }
+    const Expr *E = Call->getArg(A++);
+    if (E->containsErrors())
+      continue;
+    QualType T = argType(E);
+    bool Ok = false;
+    for (const Proto &P : Protos) {
+      if (!(P.Sig == Sig))
+        continue;
+      QualType PT = resolve(P);
+      if (!PT.isNull() && sameType(T, PT, true)) {
+        Ok = true;
+        break;
+      }
+    }
+    if (!Ok)
+      Diag(E->getBeginLoc(), diag::warn_plan9_format_mismatch)
+          << Spec << E->getType() << A;
+  }
+}
diff --git a/clang/test/Sema/plan9-varargck.c b/clang/test/Sema/plan9-varargck.c
new file mode 100644
index 0000000000000000000000000000000000000000..9fad3b7b6a7affcf80ccd3751ef12bc2f8e48a4a
--- /dev/null
+++ b/clang/test/Sema/plan9-varargck.c
@@ -0,0 +1,63 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-plan9 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple i686-unknown-plan9 -fsyntax-only -verify %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux -fsyntax-only -verify=linux %s
+
+// Plan 9's #pragma varargck, as kencc checks it (9front's sys/src/cmd/cc/dpchk.c).
+// linux-no-diagnostics
+
+typedef unsigned int uint;
+typedef long long vlong;
+typedef unsigned long uintptr;
+typedef struct Point Point;
+struct Point { int x, y; };
+typedef enum { Ea, Eb } E;            // unsigned int for gcc and clang
+typedef enum { Wa = -1, Wb = 1LL << 40 } W; // long
+
+int print(char *, ...);
+int fprint(int, char *, ...);
+int notchecked(char *, ...);
+
+#pragma varargck argpos print 1
+#pragma varargck argpos fprint 2
+#pragma varargck type "d" int
+#pragma varargck type "d" uint
+#pragma varargck type "x" int
+#pragma varargck type "lld" vlong
+#pragma varargck type "zd" uintptr
+#pragma varargck type "s" char*
+#pragma varargck type "p" void*
+#pragma varargck type "r" void
+#pragma varargck type "%" void
+#pragma varargck type "P" Point
+#pragma varargck type "c" int
+#pragma varargck flag ','
+#pragma varargck argpos print 2 // expected-warning {{varargck 'print' already defined with argument 1}}
+#pragma varargck bogus // expected-warning {{syntax in '#pragma varargck'}}
+#pragma varargck type d int // expected-warning {{syntax in '#pragma varargck'}}
+
+void f(int i, uint u, long l, vlong v, char *s, unsigned char *us, Point p,
+       Point *pp, double d, char c, E e, W w, const char *cs) {
+  print("%d %ud %5d %-d %,d\n", i, u, i, i, i);
+  print("%x %o %X\n", i, i, i); // x and X are o's: one prototype for the three
+  print("%lld %s %r %% %P %c %c\n", v, s, p, c, i);
+  print("%p %p %s\n", s, pp, cs); // void * takes any pointer, const is no matter
+  print("%d %d %x\n", e, Ea, e); // an enum is int (kencc's), unless wider
+  print("%d\n", w); // expected-warning {{format mismatch '%d' 'long}}
+  print("%*d\n", i, i);
+  fprint(2, "%s\n", s);
+  notchecked("%d\n", s);
+
+  print("%d\n", l);   // expected-warning {{format mismatch '%d' 'long', arg 2}}
+  print("%ld\n", l);  // expected-warning {{format mismatch '%ld' 'long', arg 2}}
+  print("%s\n", us);  // expected-warning {{format mismatch '%s' 'unsigned char *', arg 2}}
+  print("%d\n", d);   // expected-warning {{format mismatch '%d' 'double', arg 2}}
+  print("%P\n", pp);  // expected-warning {{format mismatch '%P' 'Point *'}}
+  print("%*d\n", s, i); // expected-warning {{format mismatch '*' in '%*d' 'char *', arg 2}}
+  print("%d %d\n", i); // expected-warning {{more format than arguments '%d'}}
+  print("%d\n", i, i); // expected-warning {{more arguments than format 'int'}}
+  fprint(2, "%s\n", i); // expected-warning {{format mismatch '%s' 'int', arg 3}}
+  // z: vlong's flag where a pointer is as wide as a vlong (long's elsewhere),
+  // a signature of its own beside ll's
+  print("%zd\n", (uintptr)0);
+  print("%lld\n", (uintptr)0); // expected-warning {{format mismatch '%lld' 'uintptr'}}
+}
