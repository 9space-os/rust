   FloatControlHandler = std::make_unique<PragmaFloatControlHandler>(Actions);
   PP.AddPragmaHandler(FloatControlHandler.get());
   if (getLangOpts().MicrosoftExt) {
@@ -615,6 +634,11 @@ void Parser::resetPragmaHandlers() {
