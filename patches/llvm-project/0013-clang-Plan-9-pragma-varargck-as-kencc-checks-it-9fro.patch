   PCSectionHandler.reset();
 
@@ -3277,6 +3301,104 @@ void PragmaDetectMismatchHandler::HandlePragma(Preprocessor &PP,
 ///
 /// "foo" is a string, which is fully macro expanded, and permits string
 /// concatenation, embedded escape characters etc.  See MSDN for more details.
+// kencc reads the pragma's words as they stand: no macro is expanded.
+void PragmaVarargckHandler::HandlePragma(Preprocessor &PP,
+                                         PragmaIntroducer Introducer,
+                                         Token &Tok) {
+  SourceLocation Loc = Tok.getLocation();
+  auto Bad = [&] {
+    PP.Diag(Loc, diag::warn_pragma_varargck_malformed);
+    while (Tok.isNot(tok::eod))
+      PP.LexUnexpandedToken(Tok);
+  };
+  // the end of the line
+  auto End = [&] {
+    PP.LexUnexpandedToken(Tok);
+    if (Tok.isNot(tok::eod)) {
+      Bad();
+      return false;
+    }
+    return true;
+  };
+
+  PP.LexUnexpandedToken(Tok);
+  if (Tok.isNot(tok::identifier))
+    return Bad();
+  StringRef Kind = Tok.getIdentifierInfo()->getName();
+  SmallString<32> Buf;
+
+  if (Kind == "argpos") {
+    PP.LexUnexpandedToken(Tok);
+    IdentifierInfo *Name = Tok.getIdentifierInfo();
+    if (!Name || Tok.is(tok::eod))
+      return Bad();
+    PP.LexUnexpandedToken(Tok);
+    unsigned Pos;
+    if (Tok.isNot(tok::numeric_constant) ||
+        PP.getSpelling(Tok, Buf).getAsInteger(10, Pos))
+      return Bad();
+    if (End())
+      Actions.Plan9().ActOnPragmaVarargckArgpos(Name, Pos, Loc);
+    return;
+  }
+
+  if (Kind == "flag") {
+    // 'c' or '\c': the character itself, no escape is translated
+    PP.LexUnexpandedToken(Tok);
+    if (Tok.isNot(tok::char_constant))
+      return Bad();
+    StringRef S = PP.getSpelling(Tok, Buf);
+    if (S.size() < 3 || S.front() != '\'' || S.back() != '\'')
+      return Bad();
+    S = S.drop_front().drop_back();
+    if (S.front() == '\\')
+      S = S.drop_front();
+    else if (S.front() == '\'')
+      return Bad();
+    const llvm::UTF8 *P = reinterpret_cast<const llvm::UTF8 *>(S.data());
+    const llvm::UTF8 *E = P + S.size();
+    llvm::UTF32 C;
+    if (S.empty() ||
+        llvm::convertUTF8Sequence(&P, E, &C, llvm::strictConversion) !=
+            llvm::conversionOK ||
+        P != E)
+      return Bad();
+    if (End())
+      Actions.Plan9().ActOnPragmaVarargckFlag(C);
+    return;
+  }
+
+  if (Kind == "type") {
+    // "FMT" without blanks, then a type's name and its stars
+    PP.LexUnexpandedToken(Tok);
+    if (Tok.isNot(tok::string_literal))
+      return Bad();
+    StringRef S = PP.getSpelling(Tok, Buf);
+    if (S.size() < 2 || S.front() != '"' || S.back() != '"')
+      return Bad();
+    std::string Fmt = S.drop_front().drop_back().str();
+    if (StringRef(Fmt).find_first_of(" ") != StringRef::npos)
+      return Bad();
+    PP.LexUnexpandedToken(Tok);
+    IdentifierInfo *Type = Tok.getIdentifierInfo();
+    if (!Type || Tok.is(tok::eod))
+      return Bad();
+    unsigned Stars = 0;
+    for (;;) {
+      PP.LexUnexpandedToken(Tok);
+      if (Tok.is(tok::eod))
+        break;
+      if (Tok.isNot(tok::star))
+        return Bad();
+      ++Stars;
+    }
+    Actions.Plan9().ActOnPragmaVarargckType(Fmt, Type, Stars, Loc);
+    return;
+  }
+
+  Bad();
+}
+
 void PragmaCommentHandler::HandlePragma(Preprocessor &PP,
                                         PragmaIntroducer Introducer,
                                         Token &Tok) {
