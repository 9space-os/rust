diff --git a/library/std/src/sys/thread/plan9.rs b/library/std/src/sys/thread/plan9.rs
index b6d5306501c216193b0ac8278987bb40647139f4..069f4a9598762c394e71548f79bae7613c7ba781 100644
--- a/library/std/src/sys/thread/plan9.rs
+++ b/library/std/src/sys/thread/plan9.rs
@@ -77,12 +77,24 @@ pub fn yield_now() {
     unsafe { libc::sleep(0) };
 }
 
-/// sleep(2) counts milliseconds: rounded up, so it never ends early.
+/// sleep(2) counts milliseconds: rounded up, so it never ends early. A note
+/// the program carries on after (one it catches) ends sleep(2) with -1: the
+/// rest is slept then, to the deadline (it returned early).
 pub fn sleep(dur: Duration) {
+    let end = crate::time::Instant::now().checked_add(dur);
     let mut ms = dur.as_nanos().div_ceil(1_000_000);
     while ms > 0 {
         let n = ms.min(i32::MAX as u128);
-        unsafe { libc::sleep(n as libc::c_long) };
+        if unsafe { libc::sleep(n as libc::c_long) } < 0 {
+            // interrupted: what is left of the whole
+            let Some(end) = end else { continue };
+            let now = crate::time::Instant::now();
+            if now >= end {
+                return;
+            }
+            ms = (end - now).as_nanos().div_ceil(1_000_000);
+            continue;
+        }
         ms -= n;
     }
 }
