-    set_state(fd, FdState::default());
-    Ok(Socket::new(unsafe { FileDesc::from_raw_fd(fd) }))
-}
 
 impl Socket {
     /// The fd, as the other platforms' sockets have it (net's Debug tests).
@@ -611,13 +605,21 @@ impl FromInner<Socket> for TcpStream {
 
 /// The next call of the announcement in `dir` (listen(2), accept(2)); a note (alarm, a pump's
 /// interrupt) ends it with Interrupted.
+///
+/// As libc's listen and accept, with each file opened close-on-exec at once: theirs
+/// were not until `socket_of` reopened them, and a child another thread spawned in
+/// between kept the call (its peer never saw it close).
 fn accept_blocking(dir: &str) -> io::Result<(Socket, SocketAddr)> {
-    let dir = CString::new(dir).unwrap();
-    let mut newdir = [0u8; 40];
-    let lcfd = cvt(unsafe { libc::listen(dir.as_ptr(), newdir.as_mut_ptr().cast()) })?;
-    let lcfd = unsafe { FileDesc::from_raw_fd(lcfd) };
-    let fd = cvt(unsafe { libc::accept(lcfd.as_raw_fd(), newdir.as_ptr().cast()) })?;
-    let s = socket_of(fd)?;
+    // listen: its open waits for a call; it reads the call's conversation
+    let lcfd = open_conv(dir, "listen")?;
+    let mut b = [0u8; 32];
+    let n = lcfd.read(&mut b)?;
+    let num = crate::str::from_utf8(&b[..n]).map_err(|_| io::const_error!(io::ErrorKind::InvalidData, "listen: a bad conversation"))?.trim();
+    let parent = dir.rsplit_once('/').map_or("", |(p, _)| p);
+    let newdir = format!("{parent}/{num}");
+    // accept: the devices that need it; its answer does not count (libc's)
+    let _ = lcfd.write(format!("accept {num}").as_bytes());
+    let s = Socket::new(open_conv(&newdir, "data")?);
     let peer = s.remote()?;
     Ok((s, peer))
 }
