@@ -579,3 +579,11 @@ pub(super) fn connecting(sock: &TcpStream, ctl: FileDesc, msg: String) -> io::Re
         p.connected(r);
     })
 }
+
+/// The error a reader or the writer ended with, for each call after it: the
+/// proc is gone, so it stays (taken once, the next read or accept waited for
+/// ever, or said WouldBlock for ever and the readiness never turned readable:
+/// mio stalled; writes after the writer's were acknowledged with no writer)
+fn again(e: &io::Error) -> io::Error {
+    io::Error::new(e.kind(), e.to_string())
+}
