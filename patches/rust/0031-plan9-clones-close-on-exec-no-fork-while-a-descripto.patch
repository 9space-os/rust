+/// Taken to read while a descriptor exists without OCEXEC, from its making to
+/// `cloexec` (pipe(2) has no such flag), and to write around spawn's rfork: a
+/// child of another thread got one of them (spawn's own exec-error pipe: that
+/// spawn waited until the other child ended, `output` saw no end of file).
+pub static NOCEXEC: crate::sync::RwLock<()> = crate::sync::RwLock::new(());
+
 /// A copy of `fd` that closes on exec (an open of dup(3)'s `#d/n` with OCEXEC; pipe(2) and
 /// dial(2) give none), in place of it.
 pub fn cloexec(fd: RawFd, mode: i32) -> io::Result<RawFd> {
