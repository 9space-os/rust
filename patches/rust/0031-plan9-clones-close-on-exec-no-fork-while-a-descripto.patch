@@ -169,12 +170,25 @@ impl BorrowedFd<'_> {
     /// Creates a new `OwnedFd` instance that shares the same underlying file
     /// description as the existing `BorrowedFd` instance.
     /// Creates a new `OwnedFd` instance that shares the same underlying file
-    /// description as the existing `BorrowedFd` instance: dup(2), the lowest free one.
+    /// description as the existing `BorrowedFd` instance: an open of dup(3)'s
+    /// `#d/n` with OCEXEC, the lowest free one, closed on exec as std's other
+    /// descriptors are (dup(2) gives one that is not: every clone, a socket's,
+    /// a pipe's, stayed open in every child spawned later, and its peer never
+    /// saw it close). In the mode the descriptor has: read and write, read,
+    /// or write, what `#d` allows.
     #[cfg(target_os = "plan9")]
     #[stable(feature = "io_safety", since = "1.63.0")]
     pub fn try_clone_to_owned(&self) -> io::Result<OwnedFd> {
-        let fd = cvt(unsafe { libc::dup(self.as_raw_fd(), -1) })?;
-        Ok(unsafe { OwnedFd::from_raw_fd(fd) })
+        let path = crate::ffi::CString::new(format!("#d/{}", self.as_raw_fd())).unwrap();
+        let mut last = None;
+        for mode in [libc::ORDWR, libc::OREAD, libc::OWRITE] {
+            let fd = unsafe { libc::open(path.as_ptr(), mode | libc::OCEXEC) };
+            if fd >= 0 {
+                return Ok(unsafe { OwnedFd::from_raw_fd(fd) });
+            }
+            last = Some(crate::sys::last_error());
+        }
+        Err(last.unwrap())
     }
 
     #[cfg(target_os = "motor")]
