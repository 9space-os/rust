+//
+// 9space study (Plan 9): the two functions of system_utils.h the shader translator uses
+// (debug.cpp); system_utils_posix.cpp is not built (dlopen and the rest: no dynamic
+// libraries on Plan 9).
+//
+
+#include "common/system_utils.h"
+
+#include <stdlib.h>
+
+namespace angle
+{
+bool IsDebuggerAttached()
+{
+    return false;
+}
+
+void BreakDebugger()
+{
+    abort();  // as system_utils_posix.cpp
+}
+}  // namespace angle
