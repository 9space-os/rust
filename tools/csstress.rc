#!/bin/rc
# csstress.rc, in a guest: /tests/csstress (tools/csstress.c: dials through
# /net/cs from many procs at once) with 12, then 50 procs of 200 dials each;
# one that fails prints STUCK and the states of cs, of the TCP conversations
# and of csstress' procs (st).  It reproduced the loopback connect hang
# patch-upstream 0025 fixed (NOTES.md, 2026-11-11).
fn st {
	echo '== cs procs'
	ps | grep ' cs$| cs ' 
	for(p in `{ps | awk '$NF == "cs" {print $2}'}) echo $p `{cat /proc/$p/status | awk '{print $3}'}
	echo '== tcp states'
	cat /net/tcp/*/status | awk '{print $1}' | sort | uniq -c
	echo '== csstress procs'
	for(p in `{ps | awk '$NF == "csstress" {print $2}'}) echo $p `{cat /proc/$p/status | awk '{print $3}'}
}
for(n in 12 50){
	/tests/csstress $n 200 >[2=1]
	if(! ~ $status ''){ echo STUCK with $n; st; exit }
}
echo csstress: all done
